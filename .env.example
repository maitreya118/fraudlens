# Copy this file to .env and fill in your real values.
# .env is git-ignored and must never be committed.

# --- CognoDB Cloud connection ---
# From console.cognodb.com after creating your free (c0) instance.
# URI must use the bolt+s:// scheme (Bolt over TLS). Example:
#   bolt+s://db-c90fe8e0.databases.cognodb.com:7687
COGNODB_URI=bolt+s://db-c90fe8e0.databases.cognodb.com:7687
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Application mode ---
# Set to "true" to force the local demo dataset instead of CognoDB
# (useful for UI development without a database). Leave unset/false
# to always try CognoDB first, which is required for the hosted app.
FRAUDLENS_DEMO_MODE=false
